            xmin = 3111.47010204082 
            xmax = 3112.07010204082 
            text = "" 
        intervals [979]:
            xmin = 3112.07010204082 
            xmax = 3117.49010204082 
            text = "But these empty wooden boxes being out there right by the back door of the store" 
        intervals [980]:
            xmin = 3117.49010204082 
            xmax = 3118.23010204082 
            text = "" 
        intervals [981]:
            xmin = 3118.23010204082 
            xmax = 3132.42511204082 
            text = "meant that when we went home such as to lunch and thing we usually went out that back door and in the summertime I was nearly always barefoot I hardly ever wore shoes in the summertime" 
        intervals [982]:
            xmin = 3132.42511204082 
            xmax = 3138.16510204082 
            text = "as a kid because I enjoyed the freedom of going barefoot but" 
        intervals [983]:
            xmin = 3138.16510204082 
            xmax = 3138.66510204082 
            text = "" 
        intervals [984]:
            xmin = 3138.66510204082 
            xmax = 3148.39010204082 
            text = "two or three times during the summer I would go out the back door and accidentally stepped on a nail which was in the cover of one of these boxes" 
        intervals [985]:
            xmin = 3148.39010204082 
            xmax = 3149.05010204082 
            text = "" 
        intervals [986]:
            xmin = 3149.05010204082 
            xmax = 3157.11010204082 
            text = "and stick this nail into myself so I would go back in the store and say dad I just stepped on a nail he'd say okay" 
        intervals [987]:
            xmin = 3157.11010204082 
            xmax = 3157.63510204082 
            text = "" 
        intervals [988]:
            xmin = 3157.63510204082 
            xmax = 3160.33510204082 
            text = "Come out and he would go to the" 
        intervals [989]:
            xmin = 3160.33510204082 
            xmax = 3161.07510204082 
            text = "" 
        intervals [990]:
            xmin = 3161.07510204082 
            xmax = 3173.71010204082 
            text = "dry goods department where he kept the bolts cloth and he would take down a bolt of unbleached muslin and tear a strip off for a bandage" 
        intervals [991]:
            xmin = 3173.71010204082 
            xmax = 3174.21010204082 
            text = "" 
        intervals [992]:
            xmin = 3174.21010204082 
            xmax = 3187.23510204082 
            text = "and then we would go back to the back end of the tour where the hardware was kept and he would wrap this bandage around my foot and then pour some turpentine onto the bandage and it would sting for a minute" 
        intervals [993]:
            xmin = 3187.23510204082 
            xmax = 3187.51509204082 
            text = "" 
        intervals [994]:
            xmin = 3187.51509204082 
            xmax = 3192.61510204082 
            text = "And he'd just say okay run around now and so I'd go on about my business" 
        intervals [995]:
            xmin = 3192.61510204082 
            xmax = 3193.83510204082 
            text = "" 
        intervals [996]:
            xmin = 3193.83510204082 
            xmax = 3202.45510204082 
            text = "I never had any abscesses or inflamatiopn from stepping on one of those nails I don't know whether the turpentine" 
        intervals [997]:
            xmin = 3202.45510204082 
            xmax = 3202.98010204082 
            text = "" 
        intervals [998]:
            xmin = 3202.98010204082 
            xmax = 3213.76010204082 
            text = "prevented it whether I just was naturally immune but I know that as I say I never had any trouble cause of stepping on one of those nails anyway" 
        intervals [999]:
            xmin = 3213.76010204082 
            xmax = 3215.07510204082 
            text = "" 
        intervals [1000]:
            xmin = 3215.07510204082 
            xmax = 3220.97510204082 
            text = "When I was small we did all the delivering of the groceries with a horse and wagon" 
