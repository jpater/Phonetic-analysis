            xmax = 3102.94510204082 
            text = "" 
        intervals [977]:
            xmin = 3102.94510204082 
            xmax = 3111.47010204082 
            text = "take a day off when we could spare it and carry all these empty boxes and accumulated debris to the town dump" 
