            xmin = 2774.15468253968 
            xmax = 2776.05968253968 
            text = "" 
        intervals [882]:
            xmin = 2776.05968253968 
            xmax = 2788.51968253968 
            text = "And then of course we sold quite a lot of dairy butter that is butter made by the local farmers and many people thought the local farmers' butter was much better than the commercial butter" 
        intervals [883]:
            xmin = 2788.51968253968 
            xmax = 2789.95470253968 
            text = "" 
        intervals [884]:
            xmin = 2789.95470253968 
