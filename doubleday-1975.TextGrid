        intervals [957]:
            xmin = 3032.25010204082 
            xmax = 3045.74510204082 
            text = "and we sold a colic healer for horses and I don't recall many of the other specific things but the farmers would occasionally come in to buy something like that for their farm animal" 
        intervals [958]:
            xmin = 3045.74510204082 
            xmax = 3046.64510204082 
            text = "" 
        intervals [959]:
            xmin = 3046.64510204082 
            xmax = 3052.22510204082 
