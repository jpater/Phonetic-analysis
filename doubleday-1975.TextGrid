            xmax = 2855.37468253968 
            text = "" 
        intervals [908]:
            xmin = 2855.37468253968 
            xmax = 2867.66968253968 
            text = "they would look them over and decide which kind they wanted sometimes they'd order a pound of mixed cookies and we put in a few cookies of this kind and a few of that kind and" 
        intervals [909]:
            xmin = 2867.66968253968 
