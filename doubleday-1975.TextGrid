            xmin = 585 
            xmax = 586.844988662132 
            text = "" 
        intervals [204]:
            xmin = 586.844988662132 
            xmax = 587.204988662132 
            text = "" 
        intervals [205]:
            xmin = 587.204988662132 
            xmax = 591.584988662132 
            text = "A teamster would then take this lumber which had just been sawed" 
        intervals [206]:
            xmin = 591.584988662132 
