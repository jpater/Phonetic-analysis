        intervals [866]:
            xmin = 2700.38968253968 
            xmax = 2705.96968253968 
            text = "and buy groceries and trade in the produce that they had towards their groceries" 
        intervals [867]:
            xmin = 2705.96968253968 
            xmax = 2707.18468253968 
            text = "" 
        intervals [868]:
            xmin = 2707.18468253968 
            xmax = 2712.74468253968 
            text = "They'd stock up this way for a whole week and I remember that" 
        intervals [869]:
            xmin = 2712.74468253968 
            xmax = 2713.34468253968 
            text = "" 
        intervals [870]:
            xmin = 2713.34468253968 
            xmax = 2722.36468253968 
            text = "we sold a lot of salt pork to those people salt pork came in large barrels of course with the brine in the barrels" 
        intervals [871]:
            xmin = 2722.36468253968 
            xmax = 2722.75968253968 
            text = "" 
        intervals [872]:
            xmin = 2722.75968253968 
            xmax = 2735.29968253968 
            text = "And the salt pork came in big chunks in this brine and we would cut it up into whatever quantity the customer wanted one pound two pounds or five pounds whatever he wanted" 
        intervals [873]:
            xmin = 2735.29968253968 
            xmax = 2736.75468253968 
            text = "" 
        intervals [874]:
            xmin = 2736.75468253968 
            xmax = 2746.41468253968 
            text = "We didn't sell any fresh meat at Hager's store they carried fresh meat but we did not have a big refrigerator" 
        intervals [875]:
            xmin = 2746.41468253968 
            xmax = 2747.47468253968 
            text = "" 
        intervals [876]:
            xmin = 2747.47468253968 
            xmax = 2755.29968253968 
            text = "So we sold only canned meats plus such things as salt pork and bacon" 
        intervals [877]:
            xmin = 2755.29968253968 
            xmax = 2755.65878272503 
            text = "" 
        intervals [878]:
            xmin = 2755.65878272503 
            xmax = 2770.87468253968 
            text = "and butter we used to get butter which came in tubs as they were called there were wooden a cast which probably held about fifty pounds of butter but we also had butter that was individually" 
        intervals [879]:
            xmin = 2770.87468253968 
            xmax = 2771.53468253968 
            text = "" 
        intervals [880]:
            xmin = 2771.53468253968 
            xmax = 2774.15468253968 
