        intervals [373]:
            xmin = 1108.69498866213 
            xmax = 1113.01002866213 
            text = "but on one end was a steel point" 
        intervals [374]:
            xmin = 1113.01002866213 
            xmax = 1114.14998866213 
            text = "" 
        intervals [375]:
            xmin = 1114.14998866213 
            xmax = 1115.16998866213 
            text = "with a" 
        intervals [376]:
            xmin = 1115.16998866213 
            xmax = 1115.82998866213 
            text = "" 
        intervals [377]:
            xmin = 1115.82998866213 
            xmax = 1119.08998866213 
            text = "movable barb on the end of an arm" 
        intervals [378]:
            xmin = 1119.08998866213 
            xmax = 1119.90998866213 
            text = "" 
        intervals [379]:
            xmin = 1119.90998866213 
            xmax = 1132.22498866213 
            text = "And when you hook this cant hook against the log the the barb was coming good sharp and arranged at a proper angle" 
        intervals [380]:
            xmin = 1132.22498866213 
            xmax = 1132.96498866213 
            text = "" 
        intervals [381]:
            xmin = 1132.96498866213 
            xmax = 1142.93998866213 
            text = "So if you went to turn the log the barb would bite into the log and you had this four or five foot handle" 
        intervals [382]:
            xmin = 1142.93998866213 
            xmax = 1143.51998866213 
            text = "" 
        intervals [383]:
            xmin = 1143.51998866213 
            xmax = 1154.05998866213 
            text = "which gave you the leverage and then that way could roll a pretty big log which much bigger than one that he could just handle by hand without any handle or peavy" 
        intervals [384]:
            xmin = 1154.05998866213 
            xmax = 1158.07498866213 
            text = "" 
        intervals [385]:
            xmin = 1158.07498866213 
            xmax = 1161.54393279054 
            text = "I mentioned the firewood" 
        intervals [386]:
            xmin = 1161.54393279054 
            xmax = 1163.03498866213 
            text = "" 
        intervals [387]:
            xmin = 1163.03498866213 
            xmax = 1165.81501866213 
            text = "and my home there in North Dana" 
        intervals [388]:
            xmin = 1165.81501866213 
            xmax = 1166.55501866213 
            text = "" 
        intervals [389]:
            xmin = 1166.55501866213 
            xmax = 1173.81998866213 
            text = "when I was small was heated entirely by wood we had about an eight room house" 
        intervals [390]:
            xmin = 1173.81998866213 
            xmax = 1174.47994866213 
            text = "" 
        intervals [391]:
            xmin = 1174.47994866213 
            xmax = 1178.77998866213 
            text = "and we had the cast iron wood stove in the kitchen" 
        intervals [392]:
            xmin = 1178.77998866213 
            xmax = 1179.75998866213 
            text = "" 
        intervals [393]:
            xmin = 1179.75998866213 
            xmax = 1184.69998866213 
            text = "in which my mother did all the cooking of course and the rest of the house" 
        intervals [394]:
            xmin = 1184.69998866213 
            xmax = 1185.31468866213 
            text = "" 
        intervals [395]:
            xmin = 1185.31468866213 
            xmax = 1187.77468866213 
            text = "was heated by a furnace" 
        intervals [396]:
            xmin = 1187.77468866213 
            xmax = 1188.67968253968 
            text = "" 
        intervals [397]:
            xmin = 1188.67968253968 
            xmax = 1189.67968243968 
            text = "" 
        intervals [398]:
            xmin = 1189.67968243968 
            xmax = 1192.45968253968 
            text = "This furnace was located in the cellar" 
        intervals [399]:
            xmin = 1192.45968253968 
            xmax = 1193.19968253968 
            text = "" 
        intervals [400]:
            xmin = 1193.19968253968 
            xmax = 1196.37968253968 
            text = "and it consisted of a iron fireback" 
        intervals [401]:
            xmin = 1196.37968253968 
            xmax = 1197.19968253968 
            text = "" 
        intervals [402]:
            xmin = 1197.19968253968 
            xmax = 1201.17968253968 
            text = "about three feet wide and six feet long" 
        intervals [403]:
            xmin = 1201.17968253968 
            xmax = 1201.91468253968 
            text = "" 
        intervals [404]:
            xmin = 1201.91468253968 
            xmax = 1206.21468253968 
            text = "It was handled would take six foot long wood" 
        intervals [405]:
            xmin = 1206.21468253968 
            xmax = 1206.79468253968 
            text = "" 
        intervals [406]:
            xmin = 1206.79468253968 
            xmax = 1208.53468253968 
            text = "And then around this" 
        intervals [407]:
            xmin = 1208.53468253968 
            xmax = 1209.03468253968 
            text = "" 
        intervals [408]:
            xmin = 1209.03468253968 
            xmax = 1212.11424212858 
            text = "was a brick structure" 
        intervals [409]:
            xmin = 1212.11424212858 
            xmax = 1213.11468253968 
            text = "" 
        intervals [410]:
            xmin = 1213.11468253968 
            xmax = 1217.71521636234 
            text = "And from the interior of this brick section" 
        intervals [411]:
            xmin = 1217.71521636234 
            xmax = 1220.14968253968 
            text = "" 
        intervals [412]:
            xmin = 1220.14968253968 
            xmax = 1225.64968253968 
            text = "sheet metal pipes ran to the different rooms of the house" 
        intervals [413]:
            xmin = 1225.64968253968 
            xmax = 1226.24468253968 
            text = "" 
        intervals [414]:
            xmin = 1226.24468253968 
            xmax = 1230.78468253968 
            text = "And conducted the hot air from the furnace up to the different rooms" 
        intervals [415]:
            xmin = 1230.78468253968 
            xmax = 1231.68468253968 
            text = "" 
        intervals [416]:
            xmin = 1231.68468253968 
            xmax = 1232.38468253968 
            text = "The" 
        intervals [417]:
            xmin = 1232.38468253968 
            xmax = 1233.60468253968 
            text = "" 
        intervals [418]:
            xmin = 1233.60468253968 
            xmax = 1237.18468253968 
            text = "hot air pipes were similar to those in use today" 
        intervals [419]:
            xmin = 1237.18468253968 
            xmax = 1237.92468253968 
            text = "" 
        intervals [420]:
            xmin = 1237.92468253968 
            xmax = 1248.99968253968 
            text = "And at the end of them in the room was a register which could be opened and closed on the floor to provide more or less heat." 
        intervals [421]:
            xmin = 1248.99968253968 
            xmax = 1249.97968253968 
            text = "" 
        intervals [422]:
            xmin = 1249.97968253968 
            xmax = 1260.73468253968 
            text = "As I said the furnace was capable of handling wood up to six feet long but we never used anything but four foot wood in it" 
        intervals [423]:
            xmin = 1260.73468253968 
            xmax = 1261.15467753968 
            text = "" 
        intervals [424]:
            xmin = 1261.15467753968 
            xmax = 1268.65468253968 
            text = "simply because this was more of a standard length and was the normal way to cut wood" 
        intervals [425]:
            xmin = 1268.65468253968 
            xmax = 1269.24968253968 
            text = "" 
        intervals [426]:
            xmin = 1269.24968253968 
            xmax = 1274.34968253968 
            text = "My father would hire some local wood chopper to go into the woods" 
        intervals [427]:
            xmin = 1274.34968253968 
            xmax = 1274.60920915712 
            text = "" 
        intervals [428]:
            xmin = 1274.60920915712 
            xmax = 1279.06968253968 
            text = "on land that my dad owned and cut firewood" 
        intervals [429]:
            xmin = 1279.06968253968 
            xmax = 1280.76967253968 
            text = "" 
        intervals [430]:
            xmin = 1280.76967253968 
            xmax = 1288.46468253968 
            text = "And the wood chopper would chop down the trees with an ax and then chop them up with an ax and do four foot lengths" 
        intervals [431]:
            xmin = 1288.46468253968 
            xmax = 1289.68468253968 
            text = "" 
        intervals [432]:
            xmin = 1289.68468253968 
            xmax = 1291.58468253968 
            text = "If the tree was" 
        intervals [433]:
            xmin = 1291.58468253968 
            xmax = 1292.08468253968 
            text = "" 
        intervals [434]:
            xmin = 1292.08468253968 
            xmax = 1305.27968253968 
            text = "large enough so that the four foot lengths of it would be pretty heavy one man to handle in other words if it weighed more than say a hundred pounds why he would then split it into smaller pieces" 
        intervals [435]:
            xmin = 1305.27968253968 
            xmax = 1305.61968253968 
            text = "" 
        intervals [436]:
            xmin = 1305.61968253968 
            xmax = 1308.95968253968 
            text = "by means of steel wedges and sledgehammer" 
        intervals [437]:
            xmin = 1308.95968253968 
            xmax = 1309.93968253968 
            text = "" 
        intervals [438]:
            xmin = 1309.93968253968 
            xmax = 1311.75968253968 
            text = "But we would get" 
        intervals [439]:
            xmin = 1311.75968253968 
            xmax = 1312.41468753968 
            text = "" 
        intervals [440]:
            xmin = 1312.41468753968 
            xmax = 1318.95469253968 
            text = "pieces of wood four feet long and up to or perhaps twelve inches in diameter" 
        intervals [441]:
            xmin = 1318.95469253968 
            xmax = 1321.05468253968 
            text = "" 
        intervals [442]:
            xmin = 1321.05468253968 
            xmax = 1324.23469253968 
            text = "Dad would then hire some local teamster" 
        intervals [443]:
            xmin = 1324.23469253968 
            xmax = 1325.21468253968 
            text = "" 
        intervals [444]:
            xmin = 1325.21468253968 
            xmax = 1331.94968253968 
            text = "to draw out the wood from the woods down to the house and with a" 
        intervals [445]:
            xmin = 1331.94968253968 
            xmax = 1332.84969253968 
            text = "" 
        intervals [446]:
            xmin = 1332.84969253968 
            xmax = 1334.82969253968 
            text = "pair of horses and teams" 
        intervals [447]:
            xmin = 1334.82969253968 
            xmax = 1335.56969253968 
            text = "" 
        intervals [448]:
            xmin = 1335.56969253968 
            xmax = 1342.50468253968 
            text = "He would pile it up outside the house just above the bulkhead which opened into the cellar" 
        intervals [449]:
            xmin = 1342.50468253968 
            xmax = 1343.56468253968 
            text = "" 
        intervals [450]:
            xmin = 1343.56468253968 
            xmax = 1350.58468253968 
            text = "And we would use about five cords of wood every winter in the furnace to heat the house" 
        intervals [451]:
            xmin = 1350.58468253968 
            xmax = 1351.32468253968 
            text = "" 
        intervals [452]:
            xmin = 1351.32468253968 
            xmax = 1353.4356238178 
            text = "And my job was to" 
        intervals [453]:
            xmin = 1353.4356238178 
            xmax = 1353.72468253968 
            text = "" 
        intervals [454]:
            xmin = 1353.72468253968 
            xmax = 1355.75968253968 
            text = "keepsake wood" 
        intervals [455]:
            xmin = 1355.75968253968 
            xmax = 1357.45968253968 
            text = "" 
        intervals [456]:
            xmin = 1357.45968253968 
            xmax = 1360.47967253968 
            text = "in the summer where dad could put it into the furnace" 
        intervals [457]:
            xmin = 1360.47967253968 
            xmax = 1361.85967253968 
            text = "" 
        intervals [458]:
            xmin = 1361.85967253968 
            xmax = 1367.45468253968 
            text = "I'd have to go up to the top of the bank there where it was piled up and" 
        intervals [459]:
            xmin = 1367.45468253968 
            xmax = 1368.27468253968 
            text = "" 
        intervals [460]:
            xmin = 1368.27468253968 
            xmax = 1373.37467253968 
            text = "throw it from there down into the open bulkhead of the cellar" 
        intervals [461]:
            xmin = 1373.37467253968 
            xmax = 1373.87467253968 
            text = "" 
        intervals [462]:
            xmin = 1373.87467253968 
            xmax = 1381.78968253968 
            text = "And of course if you weren't careful instead of the stick of wood landing in the open bulkhead it might hit the side of the house" 
        intervals [463]:
            xmin = 1381.78968253968 
            xmax = 1382.70968253968 
            text = "" 
        intervals [464]:
            xmin = 1382.70968253968 
            xmax = 1387.08968253968 
            text = "But there were little parts that you could get them to go pretty close to where you wanted them" 
        intervals [465]:
            xmin = 1387.08968253968 
            xmax = 1387.74968253968 
            text = "" 
        intervals [466]:
            xmin = 1387.74968253968 
            xmax = 1400.98469253968 
            text = "Then we would power up this wood down in the cellar or more frequently just leave it loosely as it as it landed from having thrown it in and dad would put it from there into the furnace" 
        intervals [467]:
            xmin = 1400.98469253968 
            xmax = 1401.64469253968 
            text = "" 
        intervals [468]:
            xmin = 1401.64469253968 
            xmax = 1405.46468253968 
            text = "Of course this wood was not greenwood it had to be cured" 
        intervals [469]:
            xmin = 1405.46468253968 
            xmax = 1406.28469253968 
            text = "" 
        intervals [470]:
            xmin = 1406.28469253968 
            xmax = 1419.03968253968 
            text = "And usually it cured the one season it would be cut one winter for use the following winter and we used all kinds of wood just as it came that grew in the woods would be" 
        intervals [471]:
            xmin = 1419.03968253968 
            xmax = 1419.93967253968 
            text = "" 
        intervals [472]:
            xmin = 1419.93967253968 
            xmax = 1423.59968253968 
            text = "mostly maple probably but quite a lot of oak" 
        intervals [473]:
            xmin = 1423.59968253968 
            xmax = 1424.60468253968 
            text = "" 
        intervals [474]:
            xmin = 1424.60468253968 
            xmax = 1432.42469253968 
            text = "And some birch some poplar of course birch and poplar were not as good wood for heat as as the hardwood" 
        intervals [475]:
            xmin = 1432.42469253968 
            xmax = 1434.12468253968 
            text = "" 
        intervals [476]:
            xmin = 1434.12468253968 
            xmax = 1446.61968253968 
            text = "There would also be some beech of course in the early days it would be chestnuts but by the time I was ten years old or so I most of the chestnut trees had died from the blight" 
        intervals [477]:
            xmin = 1446.61968253968 
            xmax = 1448.07968253968 
            text = "" 
        intervals [478]:
            xmin = 1448.07968253968 
            xmax = 1450.29968253968 
            text = "So we didn't get much chestnuts" 
        intervals [479]:
            xmin = 1450.29968253968 
            xmax = 1450.95968253968 
            text = "" 
        intervals [480]:
            xmin = 1450.95968253968 
            xmax = 1456.13468253968 
            text = "what I remember out to burn and of course we didn't care for the" 
        intervals [481]:
            xmin = 1456.13468253968 
            xmax = 1456.87468253968 
            text = "" 
        intervals [482]:
            xmin = 1456.87468253968 
            xmax = 1461.65468253968 
            text = "fatwood like pine and hemlock because it was not as much heat in those" 
        intervals [483]:
            xmin = 1461.65468253968 
            xmax = 1465.60968253968 
            text = "" 
        intervals [484]:
            xmin = 1465.60968253968 
            xmax = 1478.17468253968 
            text = "Also for the kitchen we would use around a number about two cords of wood a year and so the team traveled back the wood for the furnace would also leave" 
        intervals [485]:
            xmin = 1478.17468253968 
            xmax = 1478.43468253968 
            text = "" 
        intervals [486]:
            xmin = 1478.43468253968 
            xmax = 1481.53466253968 
            text = "about a couple of cords well out by the woodshed" 
        intervals [487]:
            xmin = 1481.53466253968 
            xmax = 1482.27466253968 
            text = "" 
        intervals [488]:
            xmin = 1482.27466253968 
            xmax = 1494.28970253968 
            text = "and then dad would usually hire some local man either to saw it up by hand Eddie Smith used to saw it by hand with a bucksaw and a sawhorse" 
        intervals [489]:
            xmin = 1494.28970253968 
            xmax = 1494.94968253968 
            text = "" 
        intervals [490]:
            xmin = 1494.94968253968 
            xmax = 1501.48968253968 
            text = "or sometimes dad would hire some local man who owned a fire rig as it was called a" 
        intervals [491]:
            xmin = 1501.48968253968 
            xmax = 1502.06968253968 
            text = "" 
        intervals [492]:
            xmin = 1502.06968253968 
            xmax = 1504.03468253968 
            text = "gasoline driven engine" 
        intervals [493]:
            xmin = 1504.03468253968 
            xmax = 1504.77468253968 
            text = "" 
        intervals [494]:
            xmin = 1504.77468253968 
            xmax = 1514.03468253968 
            text = "which ran the saw and usually two men would operate that one would take the four foot sticks of wood" 
        intervals [495]:
            xmin = 1514.03468253968 
            xmax = 1514.45468253968 
            text = "" 
        intervals [496]:
            xmin = 1514.45468253968 
            xmax = 1522.97968253968 
            text = "and put them on the little carriage and this carriage was killed up against the saw and it would saw a stick of wood" 
        intervals [497]:
            xmin = 1522.97968253968 
            xmax = 1524.19968253968 
            text = "" 
        intervals [498]:
            xmin = 1524.19968253968 
            xmax = 1529.93968253968 
            text = "The four foot wood would make three sticks of fire wood as a rule" 
        intervals [499]:
            xmin = 1529.93968253968 
            xmax = 1530.45468253968 
            text = "" 
        intervals [500]:
            xmin = 1530.45468253968 
            xmax = 1533.95468253968 
            text = "That would make each of them sixteen inches long of course" 
        intervals [501]:
            xmin = 1533.95468253968 
            xmax = 1535.81470253968 
            text = "" 
        intervals [502]:
            xmin = 1535.81470253968 
            xmax = 1542.75468253968 
            text = "They would take these pieces of wood that had been cut from the four foot wood and throw them into a pile" 
        intervals [503]:
            xmin = 1542.75468253968 
            xmax = 1543.32968253968 
            text = "" 
        intervals [504]:
            xmin = 1543.32968253968 
            xmax = 1548.82968253968 
            text = "And then dad or I or both of us would split that with an axe" 
        intervals [505]:
            xmin = 1548.82968253968 
            xmax = 1549.40968253968 
            text = "" 
        intervals [506]:
            xmin = 1549.40968253968 
            xmax = 1552.90966253968 
            text = "into pieces small enough to be" 
        intervals [507]:
            xmin = 1552.90966253968 
            xmax = 1553.80968253968 
            text = "" 
        intervals [508]:
            xmin = 1553.80968253968 
            xmax = 1556.58968253968 
            text = "easily used in the kitchen sove" 
        intervals [509]:
            xmin = 1556.58968253968 
            xmax = 1557.23468253968 
            text = "" 
        intervals [510]:
            xmin = 1557.23468253968 
            xmax = 1570.66968253968 
            text = "And my job was to keep the wood box in the kitchen full we a pretty big wood box in fact it was built in in the partition between the kitchen and the back room as we called it" 
        intervals [511]:
            xmin = 1570.66968253968 
            xmax = 1571.02968253968 
            text = "" 
        intervals [512]:
            xmin = 1571.02968253968 
            xmax = 1584.60968253968 
            text = "So that the wood box could be filled from the back room without actually bringing the wood into the kitchen but then there was a cover in the kitchen and you could reach in and get the wood from right in back of the kitchen stove" 
        intervals [513]:
            xmin = 1584.60968253968 
            xmax = 1585.63468253968 
            text = "" 
        intervals [514]:
            xmin = 1585.63468253968 
            xmax = 1600.36968253968 
            text = "And usually I would bring the wood in and just bump it into this big wood box helter skelter but once in a while I'd get real ambitious and I would pack it in there very carefully and then I wouldn't have to bring any more up for" 
        intervals [515]:
            xmin = 1600.36968253968 
            xmax = 1606.98968253968 
            text = "several days but most of the time I'd just bring in enough to go one day and then" 
        intervals [516]:
            xmin = 1606.98968253968 
            xmax = 1607.64968253968 
            text = "" 
        intervals [517]:
            xmin = 1607.64968253968 
            xmax = 1610.34968253968 
            text = "the following day I'd have to bring in some more" 
        intervals [518]:
            xmin = 1610.34968253968 
            xmax = 1610.92968253968 
            text = "" 
        intervals [519]:
            xmin = 1610.92968253968 
            xmax = 1612.58968253968 
            text = "And I remember that" 
        intervals [520]:
            xmin = 1612.58968253968 
            xmax = 1613.16968253968 
            text = "" 
        intervals [521]:
            xmin = 1613.16968253968 
            xmax = 1622.80468253968 
            text = "my mother would sometimes have to speak to me kind of sharp to get me to go out and bring in some wood to fill the wood box with" 
        intervals [522]:
            xmin = 1622.80468253968 
            xmax = 1626.18470253968 
            text = "" 
        intervals [523]:
            xmin = 1626.18470253968 
            xmax = 1632.66968253968 
            text = "Of course when mother was baking way she would usually use" 
        intervals [524]:
            xmin = 1632.66968253968 
            xmax = 1633.56968253968 
            text = "" 
        intervals [525]:
            xmin = 1633.56968253968 
            xmax = 1642.26968253968 
            text = "some good fairly good sized oak wood because that would burn longer you wouldn't have to replenish the fire so often" 
        intervals [526]:
            xmin = 1642.26968253968 
            xmax = 1643.34468253968 
            text = "" 
        intervals [527]:
            xmin = 1643.34468253968 
            xmax = 1652.76468253968 
            text = "But if she wanted a quick fire well then she would find some pieces of birch or perhaps an occasional pieces piece of pine or" 
        intervals [528]:
            xmin = 1652.76468253968 
            xmax = 1653.10468253968 
            text = "" 
        intervals [529]:
            xmin = 1653.10468253968 
            xmax = 1658.68468253968 
            text = "something like that the softer wood they would flare up and give her a hot fire more quickly" 
        intervals [530]:
            xmin = 1658.68468253968 
            xmax = 1659.40968253968 
            text = "" 
        intervals [531]:
            xmin = 1659.40968253968 
            xmax = 1661.70968253968 
            text = "Later on we" 
        intervals [532]:
            xmin = 1661.70968253968 
            xmax = 1662.36966253968 
            text = "" 
        intervals [533]:
            xmin = 1662.36966253968 
            xmax = 1666.34966253968 
            text = "put in a kerosene burner into that stove" 
        intervals [534]:
            xmin = 1666.34966253968 
            xmax = 1666.92966253968 
            text = "" 
        intervals [535]:
            xmin = 1666.92966253968 
            xmax = 1675.51500153576 
            text = "And this took the place of the wood I was glad of that because it was much easier to fill glass bottles with kerosene" 
        intervals [536]:
            xmin = 1675.51500153576 
            xmax = 1675.86468253968 
            text = "" 
        intervals [537]:
            xmin = 1675.86468253968 
            xmax = 1686.31968253968 
            text = "and bring that in than it was to bring in several baskets of wood and one bottle of kerosene would probably run for about twenty four hours it was" 
        intervals [538]:
            xmin = 1686.31968253968 
            xmax = 1686.97968253968 
            text = "" 
        intervals [539]:
            xmin = 1686.97968253968 
            xmax = 1694.39968253968 
            text = "pretty good sized bottles but I believe they held five gallons although I'm not sure it may have been a little smaller than that" 
        intervals [540]:
            xmin = 1694.39968253968 
            xmax = 1695.21970253968 
            text = "" 
        intervals [541]:
            xmin = 1695.21970253968 
            xmax = 1708.08465253968 
            text = "But I I like that but my mother didn't like because it didn't give as good a fire she didn't have as much control over it as she did over the wood fire and she always claimed that she couldn't bake" 
        intervals [542]:
            xmin = 1708.08465253968 
            xmax = 1708.34468253968 
            text = "" 
        intervals [543]:
            xmin = 1708.34468253968 
            xmax = 1714.46968253968 
            text = "properly it was that kerosene burner in the stove instead of the wood so" 
        intervals [544]:
            xmin = 1714.46968253968 
            xmax = 1715.28968253968 
            text = "" 
        intervals [545]:
            xmin = 1715.28968253968 
            xmax = 1722.70965253968 
            text = "in those days of course lots of other people were replacing their you know wood stoves with these kerosene heaters" 
        intervals [546]:
            xmin = 1722.70965253968 
            xmax = 1723.44968253968 
            text = "" 
        intervals [547]:
            xmin = 1723.44968253968 
            xmax = 1725.42968253968 
            text = "converting them I should say" 
        intervals [548]:
            xmin = 1725.42968253968 
            xmax = 1726.04468253968 
            text = "" 
        intervals [549]:
            xmin = 1726.04468253968 
            xmax = 1735.80463253968 
            text = "And so there were all kinds of ideas for making the oven bake better I know one thing was that we" 
        intervals [550]:
            xmin = 1735.80463253968 
            xmax = 1746.73974253968 
            text = "covered the top of the oven with brick and this was supposed to somehow make the oven work better but mother said she couldn't see it had made any difference" 
        intervals [551]:
            xmin = 1746.73974253968 
            xmax = 1746.92477598039 
            text = "" 
        intervals [552]:
            xmin = 1746.92477598039 
            xmax = 1759.79468253968 
            text = "and so she used this as an argument so that about as soon as electric stoves became available why she prevailed on dad to get her an electric stove and" 
        intervals [553]:
            xmin = 1759.79468253968 
            xmax = 1760.13465253968 
            text = "" 
        intervals [554]:
            xmin = 1760.13465253968 
            xmax = 1767.15468253968 
            text = "certainly that did work a lot better than the kerosene burner had worked in the old wood stove" 
        intervals [555]:
            xmin = 1767.15468253968 
            xmax = 1768.72968253968 
            text = "" 
        intervals [556]:
            xmin = 1768.72968253968 
            xmax = 1771.10968253968 
            text = "I mentioned the" 
        intervals [557]:
            xmin = 1771.10968253968 
            xmax = 1771.60968253968 
            text = "" 
        intervals [558]:
            xmin = 1771.60968253968 
            xmax = 1774.06968253968 
            text = "four foot wood that we used in the furnace" 
        intervals [559]:
            xmin = 1774.06968253968 
            xmax = 1775.04968253968 
            text = "" 
        intervals [560]:
            xmin = 1775.04968253968 
            xmax = 1784.96008253968 
            text = "And dad would light the fire in the furnace in the fall and then that fire would never go out from that time until warm weather came the next spring" 
        intervals [561]:
            xmin = 1784.96008253968 
            xmax = 1785.37507936508 
            text = "" 
        intervals [562]:
            xmin = 1785.37507936508 
            xmax = 1785.89507933508 
            text = "" 
        intervals [563]:
            xmin = 1785.89507933508 
            xmax = 1790.91507936508 
            text = "He would fix the fire in the morning at breakfast time" 
        intervals [564]:
            xmin = 1790.91507936508 
            xmax = 1791.65507936508 
            text = "" 
        intervals [565]:
            xmin = 1791.65507936508 
            xmax = 1799.23507936508 
            text = "And then he would come home to lunch from the store grocery store and would fix it again at lunch time" 
        intervals [566]:
            xmin = 1799.23507936508 
            xmax = 1800.13507936508 
            text = "" 
        intervals [567]:
            xmin = 1800.13507936508 
            xmax = 1813.53007836508 
            text = "And perhaps again at suppertime and then at bedtime he would go down and load it up for the night and he would throw in one or two big sticks about as big as he could lift of" 
        intervals [568]:
            xmin = 1813.53007836508 
            xmax = 1814.03007936508 
            text = "" 
        intervals [569]:
            xmin = 1814.03007936508 
            xmax = 1816.01507936508 
            text = "oak if if it was available" 
        intervals [570]:
            xmin = 1816.01507936508 
            xmax = 1817.31507936508 
            text = "" 
        intervals [571]:
            xmin = 1817.31507936508 
            xmax = 1822.09507936508 
            text = "four feet long and maybe up to a foot in diameter" 
        intervals [572]:
            xmin = 1822.09507936508 
            xmax = 1822.67507936508 
            text = "" 
        intervals [573]:
            xmin = 1822.67507936508 
            xmax = 1833.13007936508 
            text = "And this would you know would burn all night and then the next morning there would be a good bed of coals and all we would have to do would be to throw on some more wood it was" 
        intervals [574]:
            xmin = 1833.13007936508 
            xmax = 1834.51008236508 
            text = "" 
        intervals [575]:
            xmin = 1834.51008236508 
            xmax = 1836.17008136508 
            text = "all right to leave again" 
        intervals [576]:
            xmin = 1836.17008136508 
            xmax = 1836.75007936508 
            text = "" 
        intervals [577]:
            xmin = 1836.75007936508 
            xmax = 1843.84231161529 
            text = "In that row as I say the fire never went out from fall until spring and we never heated" 
        intervals [578]:
            xmin = 1843.84231161529 
            xmax = 1844.08508336508 
            text = "" 
        intervals [579]:
            xmin = 1844.08508336508 
            xmax = 1854.22507936508 
            text = "the bedrooms on the second floor of the house they had hot air pipes leading to them but we never heated them we always slept in cold bedrooms" 
        intervals [580]:
            xmin = 1854.22507936508 
            xmax = 1854.80508436508 
            text = "" 
        intervals [581]:
            xmin = 1854.80508436508 
            xmax = 1867.61007936508 
            text = "but the downstairs rooms the dining room the living room and the aprlor were all heated from the furnace and we never had any trouble keeping warm even in the coldest days" 
        intervals [582]:
            xmin = 1867.61007936508 
            xmax = 1868.03007936508 
            text = "" 
        intervals [583]:
            xmin = 1868.03007936508 
            xmax = 1873.78507936508 
            text = "regardless of how windy it was or anything else we were always perfectly comfortable in there" 
        intervals [584]:
            xmin = 1873.78507936508 
            xmax = 1908.29507936508 
            text = "" 
        intervals [585]:
            xmin = 1908.29507936508 
            xmax = 1910.91507936508 
            text = "Early recollections of North Dana" 
        intervals [586]:
            xmin = 1910.91507936508 
            xmax = 1911.57507936508 
            text = "" 
        intervals [587]:
            xmin = 1911.57507936508 
            xmax = 1914.59507936508 
            text = "I pretty closely tied in with my father's" 
        intervals [588]:
            xmin = 1914.59507936508 
            xmax = 1915.09507936508 
            text = "" 
        intervals [589]:
            xmin = 1915.09507936508 
            xmax = 1916.35507936508 
            text = "grocery store" 
        intervals [590]:
            xmin = 1916.35507936508 
            xmax = 1918.12006936508 
            text = "" 
        intervals [591]:
            xmin = 1918.12006936508 
            xmax = 1932.93507936508 
            text = "I always referred to it as the grocery store although he sold quite a lot more than just groceries as I recall the sign above the door read N N Doubleday dry goods groceries boots" 
        intervals [592]:
            xmin = 1932.93507936508 
            xmax = 1934.27507936508 
            text = "tools and hardware" 
        intervals [593]:
            xmin = 1934.27507936508 
            xmax = 1935.57507936508 
            text = "" 
        intervals [594]:
            xmin = 1935.57507936508 
            xmax = 1937.55507936508 
            text = "And he did sell all of those" 
        intervals [595]:
            xmin = 1937.55507936508 
            xmax = 1938.53507936508 
            text = "" 
        intervals [596]:
            xmin = 1938.53507936508 
            xmax = 1940.9400156462 
            text = "In addition to the groceries he" 
        intervals [597]:
            xmin = 1940.9400156462 
            xmax = 1941.65507936508 
            text = "" 
        intervals [598]:
            xmin = 1941.65507936508 
            xmax = 1942.35507936508 
            text = "especially" 
        intervals [599]:
            xmin = 1942.35507936508 
            xmax = 1942.85507936508 
            text = "" 
        intervals [600]:
            xmin = 1942.85507936508 
            xmax = 1945.23507936508 
            text = "in the earlier days he sold" 
        intervals [601]:
            xmin = 1945.23507936508 
            xmax = 1945.95007936508 
            text = "" 
        intervals [602]:
            xmin = 1945.95007936508 
            xmax = 1950.26441860075 
            text = "quite a bit of dry good For that I mean cloth" 
        intervals [603]:
            xmin = 1950.26441860075 
            xmax = 1950.59007936508 
            text = "" 
        intervals [604]:
            xmin = 1950.59007936508 
            xmax = 1954.65007936508 
            text = "for women to make dresses out of house dresses" 
        intervals [605]:
            xmin = 1954.65007936508 
            xmax = 1956.03007936508 
            text = "" 
        intervals [606]:
            xmin = 1956.03007936508 
            xmax = 1957.82336444759 
            text = "and stockings" 
        intervals [607]:
            xmin = 1957.82336444759 
            xmax = 1958.35007936508 
            text = "" 
        intervals [608]:
            xmin = 1958.35007936508 
            xmax = 1960.12507936508 
            text = "and shoes" 
        intervals [609]:
            xmin = 1960.12507936508 
            xmax = 1960.70507936508 
            text = "" 
        intervals [610]:
            xmin = 1960.70507936508 
            xmax = 1961.91240120298 
            text = "underwear" 
        intervals [611]:
            xmin = 1961.91240120298 
            xmax = 1962.30507936508 
            text = "" 
        intervals [612]:
            xmin = 1962.30507936508 
            xmax = 1964.20507936508 
            text = "We sold quite a lot of shoes" 
        intervals [613]:
            xmin = 1964.20507936508 
            xmax = 1964.70507936508 
            text = "" 
        intervals [614]:
            xmin = 1964.70507936508 
            xmax = 1966.20507936508 
            text = "when I was small" 
        intervals [615]:
            xmin = 1966.20507936508 
            xmax = 1967.58507936508 
            text = "" 
        intervals [616]:
            xmin = 1967.58507936508 
            xmax = 1969.24508936508 
            text = "then by" 
        intervals [617]:
            xmin = 1969.24508936508 
            xmax = 1969.98508936508 
            text = "" 
        intervals [618]:
            xmin = 1969.98508936508 
            xmax = 1972.12507936508 
            text = "say about nineteen twenty" 
        intervals [619]:
            xmin = 1972.12507936508 
            xmax = 1973.17007936508 
            text = "" 
        intervals [620]:
            xmin = 1973.17007936508 
            xmax = 1975.66714124548 
            text = "many people had their own automobiles" 
        intervals [621]:
            xmin = 1975.66714124548 
            xmax = 1976.21007936508 
            text = "" 
        intervals [622]:
            xmin = 1976.21007936508 
            xmax = 1984.43007936508 
            text = "so that they could drive to the larger town like Athol or Orange where they had a better" 
        intervals [623]:
            xmin = 1984.43007936508 
            xmax = 1984.93007936508 
            text = "" 
        intervals [624]:
            xmin = 1984.93007936508 
            xmax = 1990.58506936508 
            text = "stop to choose from so from that time on he did not sell very many shoes" 
        intervals [625]:
            xmin = 1990.58506936508 
            xmax = 1991.24506936508 
            text = "" 
        intervals [626]:
            xmin = 1991.24506936508 
            xmax = 2003.36007936508 
            text = "But when I was smaller he sold shoes for men women and children if I needed a pair of new shoes like I would go to the store and dad would stick me with a pair right there" 
        intervals [627]:
            xmin = 2003.36007936508 
            xmax = 2005.46007936508 
            text = "" 
        intervals [628]:
            xmin = 2005.46007936508 
            xmax = 2006.16007936508 
            text = "I" 
        intervals [629]:
            xmin = 2006.16007936508 
            xmax = 2007.38007936508 
            text = "" 
        intervals [630]:
            xmin = 2007.38007936508 
            xmax = 2009.04007936508 
            text = "in addition to that" 
        intervals [631]:
            xmin = 2009.04007936508 
            xmax = 2009.70007936508 
            text = "" 
        intervals [632]:
            xmin = 2009.70007936508 
            xmax = 2015.12007936508 
            text = "we also sold as as the sign said said boots and hardware" 
        intervals [633]:
            xmin = 2015.12007936508 
            xmax = 2016.59507936508 
            text = "" 
        intervals [634]:
            xmin = 2016.59507936508 
            xmax = 2018.81507936508 
            text = "hardware included nails" 
        intervals [635]:
            xmin = 2018.81507936508 
            xmax = 2019.79507936508 
            text = "" 
        intervals [636]:
            xmin = 2019.79507936508 
            xmax = 2020.49507936508 
            text = "hinges" 
        intervals [637]:
            xmin = 2020.49507936508 
            xmax = 2021.57728672972 
            text = "" 
        intervals [638]:
            xmin = 2021.57728672972 
            xmax = 2023.62507936508 
            text = "and door hardware" 
        intervals [639]:
            xmin = 2023.62507936508 
            xmax = 2024.81018141445 
            text = "" 
        intervals [640]:
            xmin = 2024.81018141445 
            xmax = 2025.60243228581 
            text = "paint" 
        intervals [641]:
            xmin = 2025.60243228581 
            xmax = 2029.21007936508 
            text = "" 
        intervals [642]:
            xmin = 2029.21007936508 
            xmax = 2030.42600873412 
            text = "kerosine" 
        intervals [643]:
            xmin = 2030.42600873412 
            xmax = 2031.45007936508 
            text = "" 
        intervals [644]:
            xmin = 2031.45007936508 
            xmax = 2032.63007936508 
            text = "turpintine" 
        intervals [645]:
            xmin = 2032.63007936508 
            xmax = 2035.45007936508 
            text = "" 
        intervals [646]:
            xmin = 2035.45007936508 
            xmax = 2037.67007936508 
            text = "and shotgun shells" 
        intervals [647]:
            xmin = 2037.67007936508 
            xmax = 2038.49007936508 
            text = "" 
        intervals [648]:
            xmin = 2038.49007936508 
            xmax = 2044.47007936508 
            text = "twenty two rifle bullets and a few odds and ends" 
        intervals [649]:
            xmin = 2044.47007936508 
            xmax = 2047.10507936508 
            text = "" 
        intervals [650]:
            xmin = 2047.10507936508 
            xmax = 2047.80507936508 
            text = "The" 
        intervals [651]:
            xmin = 2047.80507936508 
            xmax = 2048.70507936508 
            text = "" 
        intervals [652]:
            xmin = 2048.70507936508 
            xmax = 2051.08507936508 
            text = "groceries that we sold of course included" 
        intervals [653]:
            xmin = 2051.08507936508 
            xmax = 2052.70507936508 
            text = "" 
        intervals [654]:
            xmin = 2052.70507936508 
            xmax = 2053.40507936508 
            text = "sugar" 
        intervals [655]:
            xmin = 2053.40507936508 
            xmax = 2053.88726498839 
            text = "" 
        intervals [656]:
            xmin = 2053.88726498839 
            xmax = 2056.28507936508 
            text = "flour tea and coffee" 
        intervals [657]:
            xmin = 2056.28507936508 
            xmax = 2057.20960735214 
            text = "" 
        intervals [658]:
            xmin = 2057.20960735214 
            xmax = 2058.09130590253 
            text = "cereal" 
        intervals [659]:
            xmin = 2058.09130590253 
            xmax = 2058.97005936508 
            text = "" 
        intervals [660]:
            xmin = 2058.97005936508 
            xmax = 2061.03007936508 
            text = "spices extracts" 
        intervals [661]:
            xmin = 2061.03007936508 
            xmax = 2062.10779291802 
            text = "" 
        intervals [662]:
            xmin = 2062.10779291802 
            xmax = 2065.51005936508 
            text = "and candy and tobacco" 
        intervals [663]:
            xmin = 2065.51005936508 
            xmax = 2068.04967445319 
            text = "" 
        intervals [664]:
            xmin = 2068.04967445319 
            xmax = 2069.51005936508 
            text = "the flour" 
        intervals [665]:
            xmin = 2069.51005936508 
            xmax = 2070.01007936508 
            text = "" 
        intervals [666]:
            xmin = 2070.01007936508 
            xmax = 2071.03007936508 
            text = "and sugar" 
        intervals [667]:
            xmin = 2071.03007936508 
            xmax = 2071.61507936508 
            text = "" 
        intervals [668]:
            xmin = 2071.61507936508 
            xmax = 2074.79507936508 
            text = "Used to come to the store in barrels" 
        intervals [669]:
            xmin = 2074.79507936508 
            xmax = 2075.53509936508 
            text = "" 
        intervals [670]:
            xmin = 2075.53509936508 
            xmax = 2081.35507936508 
            text = "And then we sold it by the pound put it up in brown paper bags" 
        intervals [671]:
            xmin = 2081.35507936508 
            xmax = 2083.13507936508 
            text = "" 
        intervals [672]:
            xmin = 2083.13507936508 
            xmax = 2089.71007936508 
            text = "then later of course flower began to be packed in twenty five pound bags" 
        intervals [673]:
            xmin = 2089.71007936508 
            xmax = 2090.45007936508 
            text = "" 
        intervals [674]:
            xmin = 2090.45007936508 
            xmax = 2097.55007936508 
            text = "I don't recall if we ever had any smaller than that put up by the flower companies as they do today" 
        intervals [675]:
            xmin = 2097.55007936508 
            xmax = 2098.53007936508 
            text = "" 
        intervals [676]:
            xmin = 2098.53007936508 
            xmax = 2099.11507936508 
            text = "But" 
        intervals [677]:
            xmin = 2099.11507936508 
            xmax = 2099.79507936508 
            text = "" 
        intervals [678]:
            xmin = 2099.79507936508 
            xmax = 2101.29505936508 
            text = "in the early days" 
        intervals [679]:
            xmin = 2101.29505936508 
            xmax = 2101.87505936508 
            text = "" 
        intervals [680]:
            xmin = 2101.87505936508 
            xmax = 2104.73507936508 
            text = "he sold a great deal of flour by the barrel" 
        intervals [681]:
            xmin = 2104.73507936508 
            xmax = 2105.39507936508 
            text = "" 
        intervals [682]:
            xmin = 2105.39507936508 
            xmax = 2117.57007936508 
            text = "And on some of the trips where we delivered groceries outside the village why it was not at all unusual to have two or three barrels of flower on the delivery wagon" 
        intervals [683]:
            xmin = 2117.57007936508 
            xmax = 2118.31007936508 
            text = "" 
        intervals [684]:
            xmin = 2118.31007936508 
            xmax = 2127.51505936508 
            text = "You know families would buy a barrel of flour in the fall and that would carry them through the whole winter for their baking requirements" 
        intervals [685]:
            xmin = 2127.51505936508 
            xmax = 2128.17507936508 
            text = "" 
        intervals [686]:
            xmin = 2128.17507936508 
            xmax = 2136.79505936508 
            text = "Of course practically every woman baked her own bread in those days as well as cake cookies and pies and so on" 
        intervals [687]:
            xmin = 2136.79505936508 
            xmax = 2138.67007936508 
            text = "" 
        intervals [688]:
            xmin = 2138.67007936508 
            xmax = 2142.17005936508 
            text = "So we did quite a big business in bread flour" 
        intervals [689]:
            xmin = 2142.17005936508 
            xmax = 2143.07007936508 
            text = "" 
        intervals [690]:
            xmin = 2143.07007936508 
            xmax = 2144.09007936508 
            text = "Later on" 
        intervals [691]:
            xmin = 2144.09007936508 
            xmax = 2144.75007936508 
            text = "" 
        intervals [692]:
            xmin = 2144.75007936508 
            xmax = 2158.37507936508 
            text = "we sold baker's bread so called and I remember that it took many women refused buy it they said it was no good they could make a lot better bread themselves and I agree with them" 
        intervals [693]:
            xmin = 2158.37507936508 
            xmax = 2159.43505936508 
            text = "" 
        intervals [694]:
            xmin = 2159.43505936508 
            xmax = 2167.85007936508 
            text = "And then gradually however they they gave up the practice of baking their own bread to a great extent" 
        intervals [695]:
            xmin = 2167.85007936508 
            xmax = 2169.15007936508 
            text = "" 
        intervals [696]:
            xmin = 2169.15007936508 
            xmax = 2173.13007936508 
            text = "And then the baker's bread came through already sliced" 
        intervals [697]:
            xmin = 2173.13007936508 
            xmax = 2173.63007936508 
            text = "" 
        intervals [698]:
            xmin = 2173.63007936508 
            xmax = 2186.40507936508 
            text = "And again the women objected to this they said the bread didn't keep as well when it was already sliced and there was quite a bit of objection for quite a long while we carried both sliced and un sliced bread" 
        intervals [699]:
            xmin = 2186.40507936508 
            xmax = 2186.90505936508 
            text = "" 
        intervals [700]:
            xmin = 2186.90505936508 
            xmax = 2193.92507936508 
            text = "But gradually women accepted the sliced bread and finally we stopped carrying un sliced bread completely" 
        intervals [701]:
            xmin = 2193.92507936508 
            xmax = 2195.93007936508 
