            xmin = 3082.41509804082 
            xmax = 3083.05010204082 
            text = "" 
        intervals [973]:
            xmin = 3083.05010204082 
            xmax = 3089.11010204082 
            text = "And so we had a great many of these empty wooden boxes to get rid of and when we" 
        intervals [974]:
            xmin = 3089.11010204082 
            xmax = 3089.93010204082 
            text = "" 
        intervals [975]:
            xmin = 3089.93010204082 
            xmax = 3102.68510204082 
            text = "emptied out the contents of a wooden box and put the cans on to one of the shelves then we would throw the empty box out the back door of the store and then about once a year why we'd" 
