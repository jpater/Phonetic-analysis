            text = "" 
        intervals [712]:
            xmin = 2236.01007936508 
            xmax = 2248.62507936508 
            text = "package the sugar during slack times during the store so that we'd have a a supply of it like they're handy and wouldn't have to stop to weigh it out whenever a lady wanted to buy a couple of pounds of sugar" 
