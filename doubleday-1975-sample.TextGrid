            xmin = 544.7798402050538 
            xmax = 545.7748402050538 
            text = "" 
        intervals [211]:
            xmin = 545.7748402050538 
            xmax = 553.5948402050548 
            text = "And with a pair of horses he would drive from the mill out to the area where it was stuck up so to speak" 
        intervals [212]:
            xmin = 553.5948402050548 
            xmax = 555.6948402050548 
            text = "" 
        intervals [213]:
            xmin = 555.6948402050548 
            xmax = 561.0498402050548 
            text = "Sticking up this lumber consisted of first laying down" 
