            xmin = 539.5798402050548 
            xmax = 540.3198402050548 
            text = "" 
        intervals [209]:
            xmin = 540.3198402050548 
            xmax = 544.7798402050538 
            text = "load it under his wagon or it was in the wintertime his sled" 
