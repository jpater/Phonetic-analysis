            xmax = 636.1448402050538 
            text = "" 
        intervals [237]:
            xmin = 636.1448402050538 
            xmax = 646.8448402050548 
            text = "They would vary in width but this didn't make any difference of course and these board sticks were what separated the layers of boards or planks in the piles of lumber" 
