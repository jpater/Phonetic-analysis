            xmin = 526.0848015429227 
            xmax = 526.3748515429228 
            text = "" 
        intervals [202]:
            xmin = 526.3748515429228 
            xmax = 531.6348515429228 
            text = "And on a good day they would saw several thousand board feet of lumber" 
