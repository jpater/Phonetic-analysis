            xmin = 468.3198967733268 
            xmax = 468.62485154292284 
            text = "" 
        intervals [190]:
            xmin = 468.62485154292284 
            xmax = 480.3098515429228 
            text = "mark on it the number of board feet in that board of course a board foot is a board one foot wide one foot long and one inch thick" 
        intervals [191]:
            xmin = 480.3098515429228 
            xmax = 481.2898515429228 
            text = "" 
        intervals [192]:
            xmin = 481.2898515429228 
            xmax = 485.0298115429228 
            text = "So if you had a board which was ten feet long" 
        intervals [193]:
            xmin = 485.0298115429228 
            xmax = 485.98485154292285 
            text = "" 
        intervals [194]:
            xmin = 485.98485154292285 
            xmax = 499.88485154292283 
            text = "one foot wide and one inch thick that board would have ten board feet in it and the marker would have a piece of heavy crayon and he would mark a ten on that board" 
        intervals [195]:
            xmin = 499.88485154292283 
            xmax = 500.25985154292283 
            text = "" 
        intervals [196]:
            xmin = 500.25985154292283 
            xmax = 509.0398215429229 
            text = "If the board was the same size but two inches thick it would have twenty board feet in it and he'd mark a twenty on it and so on" 
        intervals [197]:
            xmin = 509.0398215429229 
            xmax = 510.25985154292283 
            text = "" 
        intervals [198]:
            xmin = 510.25985154292283 
            xmax = 513.9198515429227 
            text = "He also had a peg board hanging on the wall" 
        intervals [199]:
            xmin = 513.9198515429227 
            xmax = 514.9048515429228 
            text = "" 
        intervals [200]:
            xmin = 514.9048515429228 
            xmax = 526.0848015429227 
            text = "And by moving the pigs into different holes in this board he was able to keep track of the number of board feet of lumber that was sawed during the day by the mill" 
