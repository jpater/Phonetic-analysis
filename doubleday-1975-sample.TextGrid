            xmin = 298.01697751259985 
            xmax = 298.7798515429228 
            text = "" 
        intervals [136]:
            xmin = 298.7798515429228 
            xmax = 304.99987154292285 
            text = "which was shot pointed and were raised up and down on steel posts" 
        intervals [137]:
            xmin = 304.99987154292285 
            xmax = 306.13987154292283 
            text = "" 
        intervals [138]:
            xmin = 306.13987154292283 
            xmax = 311.31985154292283 
            text = "The roller would jam me two dogs into the log and this would hold it." 
        intervals [139]:
            xmin = 311.31985154292283 
            xmax = 312.37485154292284 
            text = "" 
        intervals [140]:
            xmin = 312.37485154292284 
            xmax = 322.11483154292284 
            text = "The sawyer would then move the carriage over by means of a handle which he could pull on move the carriage over" 
        intervals [141]:
            xmin = 322.11483154292284 
            xmax = 322.7748515429228 
            text = "" 
        intervals [142]:
            xmin = 322.7748515429228 
            xmax = 328.0198515429228 
            text = "so that ours would passed by the saw the saw would cut off" 
        intervals [143]:
            xmin = 328.0198515429228 
            xmax = 328.67985154292285 
            text = "" 
        intervals [144]:
            xmin = 328.67985154292285 
            xmax = 330.73985154292285 
            text = "a section of the log" 
        intervals [145]:
            xmin = 330.73985154292285 
            xmax = 331.87985154292284 
            text = "" 
        intervals [146]:
            xmin = 331.87985154292284 
            xmax = 340.0248515429228 
            text = "And the first section that was cut off was called the slab because this contained mostly bark" 
        intervals [147]:
            xmin = 340.0248515429228 
            xmax = 341.42487154292286 
            text = "" 
        intervals [148]:
            xmin = 341.42487154292286 
            xmax = 348.92485154292285 
            text = "And usually the way they did it was they would saw off the slab in other words take the first cut" 
        intervals [149]:
            xmin = 348.92485154292285 
            xmax = 349.6648515429228 
            text = "" 
        intervals [150]:
            xmin = 349.6648515429228 
            xmax = 356.44982154292285 
            text = "Then the sawyer would run the carriage backwards and then move the carriage over" 
        intervals [151]:
            xmin = 356.44982154292285 
            xmax = 358.1498515429228 
            text = "" 
        intervals [152]:
            xmin = 358.1498515429228 
            xmax = 365.9698515429228 
            text = "certain amount if he wanted a one inch board he would move it one inch if he wanted a two inch board he would move it two inches and so on" 
        intervals [153]:
            xmin = 365.9698515429228 
            xmax = 366.68485154292284 
            text = "" 
        intervals [154]:
            xmin = 366.68485154292284 
            xmax = 377.62485154292284 
            text = "And then he would run the carriage forward past the saw again and the saw would cut off whatever thickness of board the sawyer had moved the carriage for" 
