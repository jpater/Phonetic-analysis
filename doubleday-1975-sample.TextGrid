            xmin = 580.0148402050538 
            xmax = 581.0748422050548 
            text = "" 
        intervals [219]:
            xmin = 581.0748422050548 
            xmax = 594.3898402050538 
            text = "and then start laying the planks on top of them and he would wrap with a pile perhaps five or six feet wide when he got one layer of planks or boards laid down" 
