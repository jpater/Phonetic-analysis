            xmax = 388.4698515429228 
            text = "" 
        intervals [164]:
            xmin = 388.4698515429228 
            xmax = 393.56985154292283 
            text = "So that the part which had already been sawed would be flat up against the carriage" 
        intervals [165]:
            xmin = 393.56985154292283 
            xmax = 394.38987154292283 
            text = "" 
        intervals [166]:
            xmin = 394.38987154292283 
            xmax = 402.30485154292285 
            text = "And this time the two rods were turned around so that a shorter bar would be holding the" 
