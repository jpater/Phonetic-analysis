            xmin = 561.0498402050548 
            xmax = 561.7898402050538 
            text = "" 
        intervals [215]:
            xmin = 561.7898402050538 
            xmax = 575.6948402050548 
            text = "some heavy pieces of slab on the ground so to get a fairly level foundation to start with and also get it up off of the ground because if The lumber was piled directly on the ground it would rot very quickly" 
        intervals [216]:
            xmin = 575.6948402050548 
            xmax = 576.2748432050538 
            text = "" 
        intervals [217]:
            xmin = 576.2748432050538 
            xmax = 580.0148402050538 
