            xmax = 288.45487154292283 
            text = "" 
        intervals [132]:
            xmin = 288.45487154292283 
            xmax = 295.07485154292283 
            text = "So the roller rolled a log onto the carriage and it was held there by two" 
        intervals [133]:
            xmin = 295.07485154292283 
            xmax = 295.73987154292286 
            text = "" 
        intervals [134]:
            xmin = 295.73987154292286 
            xmax = 298.01697751259985 
